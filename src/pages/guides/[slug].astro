---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ArticleView from '../../components/ArticleView.astro';
import { isDemoEntry } from '../../data/utils/demo-filter';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ id, data }) => !isDemoEntry(id) && data.type === 'guide');
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
---

<ArticleView article={article} hubLabel="选购指南" hubHref="/guides/" />
