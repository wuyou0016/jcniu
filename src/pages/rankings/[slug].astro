const config = CONFIGS[kind];

function bestPlan(row: BoardRow) {
  return cheapestMonthly(row.provider);
}

let rows: BoardRow[] = [];
if (kind === 'cheap' || kind === 'best-value') {
  rows = board.rows
    .filter((row) => bestPlan(row) !== null)
    .sort((a, b) => bestPlan(a)!.monthly - bestPlan(b)!.monthly || a.rank - b.rank);
} else if (kind === 'dedicated-line') {
  rows = board.rows.filter((row) => hasDedicatedRoute(row.provider));
} else if (kind === 'monthly') {
  rows = board.rows.filter((row) => hasMonthlyPlan(row.provider));
} else {
  // stable：只列"资料基础"——专线线路 + 节点地区 ≥4，不含任何性能结论
  rows = board.rows.filter(
    (row) => hasDedicatedRoute(row.provider) && (row.provider.data.vendor.regions ?? []).length >= 4,
  );
}

const canonicalUrl = resolveCanonicalUrl(`/rankings/${kind}/`);
const itemListJsonLd =
  kind !== 'stable'
    ? {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: config.h1,
        itemListElement: rows.map((row, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: row.provider.data.name,
          url: resolveCanonicalUrl(`/airports/${row.provider.data.slug}/`),
        })),
      }
    : null;
void canonicalUrl;

function ratio(row: BoardRow): string {
  const best = bestPlan(row);
  const gb = trafficGb(best?.plan.quota);
  if (!best || gb === null) return '—';
  return (gb / best.monthly).toFixed(1);
}
---

<BaseLayout title={config.title} description={config.description} keywords={config.keywords}>
  <Breadcrumbs
    items={[
      { name: '机场推荐排行榜', href: '/rankings/' },
      { name: config.breadcrumb, href: `/rankings/${kind}/` },
    ]}
  />
  <span class="section__eyebrow">RANKINGS · {kind.toUpperCase()}</span>
  <h1>{config.h1}</h1>
  <p class="lead">{config.lead}</p>

  {
    config.intro.map((block) => (
      <>
        <h2>{block.heading}</h2>
        {block.paragraphs.map((p) => <p set:html={p} />)}
      </>
    ))
  }

  <h2>
    {kind === 'cheap' && '便宜机场榜单：按月均价从低到高'}
    {kind === 'best-value' && '性价比对照表：月均价、流量与每元流量'}
    {kind === 'dedicated-line' && '资料里标注了专线线路的机场'}
    {kind === 'monthly' && '资料里有月付套餐的机场'}
    {kind === 'stable' && '稳定性判断的“资料基础”：专线线路加四个以上节点地区'}
  </h2>

  {
    kind === 'stable' && (
      <div class="callout callout--warn">
        <h3>实时检测中</h3>
        <p>
          下表只列资料基础（有专线线路记录、节点地区不少于 4 个），<b>不是稳定性排名</b>。晚高峰丢包率、延迟抖动等指标目前没有机场牛的测试记录，标注为“实时检测中”，不拿第三方转述或模拟示例图充数。
        </p>
      </div>
    )
  }

  {
    rows.length === 0 ? (
      <div class="empty-state">
        <p class="empty-state__title">暂时没有符合条件的品牌</p>
        <p>资料补齐后这里会自动出现。先看看<a href="/rankings/">机场推荐总榜</a>。</p>
      </div>
    ) : (
      <div class="table-wrap">
        <table>
          <thead>
            {kind === 'cheap' && (
              <tr>
                <th class="num">#</th>
                <th>品牌</th>
                <th>资料里的最低月均价</th>
                <th>对应套餐</th>
                <th>流量</th>
                <th>档位</th>
              </tr>
            )}
            {kind === 'best-value' && (
              <tr>
                <th class="num">#</th>
                <th>品牌</th>
                <th>月均价</th>
                <th>流量额度</th>
                <th>每元流量</th>
                <th>线路</th>
                <th>档位</th>
              </tr>
            )}
            {kind === 'dedicated-line' && (
              <tr>
                <th class="num">名次</th>
                <th>品牌</th>
                <th>线路标注</th>
                <th>价格</th>
                <th>节点地区</th>
                <th>档位</th>
              </tr>
            )}
            {kind === 'monthly' && (
              <tr>
                <th class="num">名次</th>
                <th>品牌</th>
                <th>月付套餐</th>
                <th>线路</th>
                <th>档位</th>
              </tr>
            )}
            {kind === 'stable' && (
              <tr>
                <th class="num">名次</th>
                <th>品牌</th>
                <th>线路标注</th>
                <th>节点地区</th>
                <th>晚高峰稳定性</th>
              </tr>
            )}
          </thead>
          <tbody>
            {rows.map((row, index) => {
              const p = row.provider.data;
              const best = bestPlan(row);
              const routes = (p.vendor.routes ?? []).map(cleanLabel).join('、') || '资料空白';
              const regions = (p.vendor.regions ?? []).join('、') || '资料空白';
              const tier = <span class={`tier-pill tier-pill--${row.tier}`}>{tierLabel.get(row.tier)}</span>;
              const name = <a href={`/airports/${p.slug}/`}>{p.name}</a>;
              if (kind === 'cheap')
                return (
                  <tr>
                    <td class="num">{index + 1}</td>
                    <td>{name}</td>
                    <td class="num">¥{best!.monthly}/月</td>
                    <td>{best!.plan.name}（{best!.plan.cycle || '周期未注明'}）</td>
                    <td>{best!.plan.quota || '资料未注明'}</td>
                    <td>{tier}</td>
                  </tr>
                );
              if (kind === 'best-value')
                return (
                  <tr>
                    <td class="num">{index + 1}</td>
                    <td>{name}</td>
                    <td class="num">¥{best!.monthly}/月</td>
                    <td>{best!.plan.quota || '资料未注明'}</td>
                    <td class="num">{ratio(row)}</td>
                    <td>{routes}</td>
                    <td>{tier}</td>
                  </tr>
                );
              if (kind === 'dedicated-line')
                return (
                  <tr>
                    <td class="num">{row.rank}</td>
                    <td>{name}</td>
                    <td>{routes}</td>
                    <td>{best ? `${best.plan.price}${best.plan.cycle ? `（${best.plan.cycle}）` : ''}` : planFacts(row.provider)[0]?.price ?? '价格空白'}</td>
                    <td>{regions}</td>
                    <td>{tier}</td>
                  </tr>
                );
              if (kind === 'monthly')
                return (
                  <tr>
                    <td class="num">{row.rank}</td>
                    <td>{name}</td>
                    <td>
                      {planFacts(row.provider)
                        .filter((plan) => plan.cycle === '按月付费')
                        .map((plan) => `${plan.name} ${plan.price}·${plan.quota || '流量未注明'}`)
                        .join('；')}
                    </td>
                    <td>{routes}</td>
                    <td>{tier}</td>
                  </tr>
                );
              return (
                <tr>
                  <td class="num">{row.rank}</td>
                  <td>{name}</td>
                  <td>{routes}</td>
                  <td>{regions}</td>
                  <td><span class="source-badge">实时检测中</span></td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )
  }

  {
    config.outro.map((block) => (
      <>
        <h2>{block.heading}</h2>
        {block.paragraphs.map((p) => <p set:html={p} />)}
      </>
    ))
  }

  <h2>相关榜单与指南</h2>
  <ul class="quick-links">
    {config.related.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
  </ul>

  <FaqBlock heading={`${config.breadcrumb}常见问题`} items={config.faqs} />

  {itemListJsonLd && <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />}
</BaseLayout>
