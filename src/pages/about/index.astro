---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import { getBoard } from '../../data/utils/board';

const board = await getBoard();
const snapshot = board.snapshotAt.toISOString().slice(0, 10);

const faqs = [
  { q: '机场牛的榜单能代表机场好不好用吗？', a: '不能完全代表。榜单只反映资料透明度：价格、线路、协议、地区、客户端和来源是否能核对。好不好用取决于速度、稳定性和你的网络环境，这些需要连续测试，机场牛目前没有测试记录，所以不给结论，页面上标注为实时检测中。' },
  { q: '机场牛的数据来源有哪些？', a: '分四类并逐条标注：官方公开信息、第三方资料（如导航站）、站长或编辑确认、本站实测。四类不混在一起，也不把转述当成官方。来源方自己标注为模拟示例的数据，机场牛一律不采信。' },
  { q: '榜单多久更新，怎么保证不偏袒？', a: '品牌资料有变化时更新并同步调整档位，更新时间见《更新记录》。前七名顺序为编辑指定，规则公开在本页；第八名起按资料完整度排列，每家都附理由，你可以逐条核对，发现错误可以反馈。' },
];
---

<BaseLayout
  title="夯到拉怎么评？机场牛榜单评定规则、数据来源与更新方式"
  description="机场牛榜单评定规则：夯、顶级、人上人、NPC、路人五档加“拉完了”名单分别意味着什么，前七名顺序与第八名起的排序依据，价格、线路、协议、地区、来源五项怎么核对，数据来源分几类，哪些内容机场牛不写，更新与反馈方式一并公开。"
  keywords={['机场评测方法', '机场排行榜', '机场推荐', '夯到拉', '机场牛']}
>
  <Breadcrumbs items={[{ name: '夯到拉怎么评', href: '/about/' }]} />
  <span class="section__eyebrow">ABOUT · RULES · 快照 {snapshot}</span>
  <h1>夯到拉怎么评：机场牛榜单的评定规则</h1>
  <p class="lead">
    机场牛是一个机场推荐与资料整理站。我们的原则很简单：只写查得到来源的事，不写没有依据的好话，也不把没有证据的坏话说成事实。下面把榜单怎么排、数据哪来、什么不写，全部公开。
  </p>

  <h2>六档分别意味着什么</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>档位</th><th>一句话</th><th>判定依据</th><th class="num">家数</th></tr></thead>
      <tbody>
        {
          board.tiers.map((tier) => (
            <tr>
              <td><span class={`tier-pill tier-pill--${tier.id}`}>{tier.label}</span></td>
              <td><b>{tier.tagline}</b></td>
              <td>{tier.rule}</td>
              <td class="num">{tier.rows.length + tier.fallen.length}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2>名次怎么排</h2>
  <p>
    前七名的顺序为编辑指定，沿用热门榜单口径：无忧链接、飞猫云、微风网络、Firefly、光速云、星岛梦、闪跃。第八名起按资料完整度排列：先是价格和线路至少有一项公开的品牌，最后是价格线路都查不到资料的品牌。每家品牌都附一句话理由，写明依据了哪些资料。
  </p>
  <p>
    榜单没有“综合评分”：行业里的价格、协议、线路信息大多是自由文本，没法可靠地算成互相可比的数字。与其发明一个看似客观的分数，不如把每一项资料摆出来，让你自己判断。
  </p>

  <h2>五个核对问题</h2>
  <ul class="criteria">
    <li><span class="criteria__no">01</span><b>价格公开吗</b>套餐、流量、计费周期能不能在官网直接看到，不注册、不问客服。</li>
    <li><span class="criteria__no">02</span><b>线路说清了吗</b>专线还是中转，IPLC、IEPL 还是别的，有没有明确写出。</li>
    <li><span class="criteria__no">03</span><b>协议和客户端呢</b>协议、支持的客户端是否具体，而不是笼统的“支持主流客户端”。</li>
    <li><span class="criteria__no">04</span><b>来源能追溯吗</b>每条信息是官方、第三方还是编辑观点，有没有链接和日期。</li>
    <li><span class="criteria__no">05</span><b>有没有多源印证</b>同一个价格是不是被两个独立来源对上，孤证会明确降一档。</li>
  </ul>

  <h2>数据来源分四类</h2>
  <ul>
    <li><b>官方公开信息</b>：品牌官网上直接能看到的价格、套餐和说明。</li>
    <li><b>第三方资料</b>：导航站、评测站整理的信息，只算转述，会标注来源名称和获取日期。</li>
    <li><b>站长或编辑确认</b>：由站长直接确认的信息，比如某个套餐价格。</li>
    <li><b>本站实测</b>：机场牛自己的测试记录。目前还没有，所以速度、稳定性和解锁能力的位置都写“实时检测中”。</li>
  </ul>

  <h2>哪些内容机场牛不写</h2>
  <ul>
    <li>没有来源的速度、延迟、稳定性、解锁结论。来源方自己标注为模拟示例的测速图，一律不采信。</li>
    <li>用户数、访问量、评分、“XX 人在用”这类无法核实的数字。</li>
    <li>没有证据的跑路传闻。“拉完了”名单只收有明确标注的，目前仅奈云一家（站长标注，无公开证据细节）；传闻和来源不明的截图一律不收。</li>
    <li>对商家的夸大宣传（“秒开不卡顿”“全自研高可用”），除非有可核对的来源并标注为商家说法。</li>
  </ul>

  <h2>更新与反馈</h2>
  <p>
    品牌资料有变化时我们更新档案并同步调整档位，改动记录在<a href="/changelog/">更新记录</a>。发现错误、想补充资料或申请入驻，通过页脚的“入驻申请”联系我们，核实后更新。
  </p>

  <FaqBlock heading="关于榜单的常见问题" items={faqs} />
</BaseLayout>
