---
// 问答区块：页面可见的问答文字就是 FAQPage JSON-LD 里的文字（同一份 items 渲染两次），
// 不会出现"结构化数据里有、页面上没有"的问答。jsonLd=false 时只渲染可见部分，
// 用于 /faq/ 总页（那里统一输出一份包含全部问答的 JSON-LD）。
interface Props {
  items: { q: string; a: string }[];
  heading?: string;
  jsonLd?: boolean;
  id?: string;
}

const { items, heading, jsonLd = true, id } = Astro.props;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

{
  items.length > 0 && (
    <section class="faq-block" id={id}>
      {heading && <h2>{heading}</h2>}
      <div class="faq-block__list">
        {items.map((item) => (
          <div class="faq-block__item">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </div>
      {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
    </section>
  )
}

<style>
  .faq-block__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .faq-block__item {
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .faq-block__item h3 {
    margin: 0 0 var(--space-2);
    font-size: 1rem;
    line-height: 1.5;
  }

  .faq-block__item p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.75;
  }
</style>
