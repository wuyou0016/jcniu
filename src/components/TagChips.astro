---
// 关键词标签入口：指向 /tag/{slug}/ 关键词聚合页，给文章页和品牌页做站内导流。
interface Props {
  tags: { slug: string; name: string }[];
  label?: string;
}

const { tags, label = '相关标签' } = Astro.props;
---

{
  tags.length > 0 && (
    <div class="tag-chips">
      <span class="tag-chips__label">{label}</span>
      <ul>
        {tags.map((tag) => (
          <li>
            <a href={`/tag/${tag.slug}/`}>{tag.name}</a>
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  .tag-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin: var(--space-6) 0;
  }

  .tag-chips__label {
    color: var(--color-muted);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .tag-chips ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-chips a {
    display: inline-block;
    padding: 0.2rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface-soft);
    color: var(--color-text);
    font-size: 0.8125rem;
    text-decoration: none;
  }

  .tag-chips a:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
</style>
